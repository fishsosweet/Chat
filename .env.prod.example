# ========================
# Database / Cache
# ========================
POSTGRES_DB=chat_app
POSTGRES_USER=chat_user
POSTGRES_PASSWORD=replace_with_strong_db_password
REDIS_ENABLE=true

# ========================
# Security
# ========================
JWT_ACCESS_SECRET=replace_with_at_least_32_characters_access_secret
JWT_REFRESH_SECRET=replace_with_at_least_32_characters_refresh_secret
JWT_EMAIL_VERIFY_SECRET=replace_with_at_least_32_characters_email_verify_secret
JWT_RESET_PASSWORD_SECRET=replace_with_at_least_32_characters_reset_password_secret

# ========================
# App / Admin / CORS
# ========================
# If web is served on one domain via this compose, set it to that exact origin.
CORS_ORIGINS=https://chat.example.com
ADMIN_EMAILS=admin@example.com

# ========================
# RTC (TURN/STUN)
# ========================
RTC_ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,turn:turn.example.com:3478
RTC_TURN_USERNAME=
RTC_TURN_CREDENTIAL=

# ========================
# Build-time frontend URLs
# ========================
CLIENT_VITE_API_BASE_URL=https://chat.example.com/api/v1
CLIENT_VITE_SOCKET_URL=https://chat.example.com
ADMIN_VITE_API_BASE_URL=https://chat.example.com/api/v1
